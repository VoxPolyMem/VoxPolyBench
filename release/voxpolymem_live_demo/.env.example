# Text model and ASR use an OpenAI-compatible API. Never put real keys in Git.
DEMO_API_KEY=
DEMO_API_BASE=https://api.openai.com/v1
DEMO_LLM_MODEL=gpt-4.1-mini
DEMO_ASR_MODEL=gpt-4o-mini-transcribe
DEMO_ASR_BACKEND=openai

# Path to the separate frozen VoxPolyMem v1 release. Its files are never edited.
VOXPOLYMEM_SOURCE=../voxpolymem_code

# Optional local ASR: set DEMO_ASR_BACKEND=faster_whisper and install it.
DEMO_WHISPER_MODEL=small

# Enable for real one-turn-per-speaker acoustic matching using the frozen pipeline.
# It requires the optional speaker dependencies, ffmpeg, and ECAPA weights.
DEMO_SPEAKER_BACKEND=off
DEMO_SPEAKER_DEVICE=cpu
ECAPA_MODEL=speechbrain/spkrec-ecapa-voxceleb

DEMO_HOST=127.0.0.1
DEMO_PORT=8788
DEMO_TOP_K=20
